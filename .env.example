# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# EXA_API_KEY: Required for MKUU live/current web search.
# Keep this server-side only; never expose it in frontend code.
EXA_API_KEY="MY_EXA_API_KEY"

# SIKASIO_API_KEY: Required for MKUU Image Studio image generation.
# Keep this server-side only; never expose it in frontend code.
SIKASIO_API_KEY="igk_live_YOUR_SIKASIO_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
