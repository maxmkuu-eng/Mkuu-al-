# GEMINI_API_KEY: Required for Gemini AI API calls and native Google Search grounding.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# POLLINATIONS_API_KEY: Required for MKUU Image Studio generation/editing.
# Keep this server-side only; never expose it in frontend code.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
