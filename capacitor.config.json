{
  "appId": "com.mkuu.ai",
  "appName": "Mkuu AI",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.run.app",
      "*.googleapis.com",
      "*.google.com",
      "*.cloudfunctions.net",
      "localhost",
      "10.0.2.2"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
